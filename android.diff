diff --git a/src/main/java/org/kde/kdeconnect/plugins/mousepad/StationMqttClient.java b/src/main/java/org/kde/kdeconnect/plugins/mousepad/StationMqttClient.java
new file mode 100644
index 00000000..c405ca3a
--- /dev/null
+++ b/src/main/java/org/kde/kdeconnect/plugins/mousepad/StationMqttClient.java
@@ -0,0 +1,170 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+package org.kde.kdeconnect.plugins.mousepad;
+
+import android.util.Log;
+
+import org.eclipse.paho.client.mqttv3.IMqttActionListener;
+import org.eclipse.paho.client.mqttv3.IMqttDeliveryToken;
+import org.eclipse.paho.client.mqttv3.IMqttToken;
+import org.eclipse.paho.client.mqttv3.MqttAsyncClient;
+import org.eclipse.paho.client.mqttv3.MqttCallbackExtended;
+import org.eclipse.paho.client.mqttv3.MqttClientPersistence;
+import org.eclipse.paho.client.mqttv3.MqttConnectOptions;
+import org.eclipse.paho.client.mqttv3.MqttException;
+import org.eclipse.paho.client.mqttv3.MqttMessage;
+import org.eclipse.paho.client.mqttv3.persist.MemoryPersistence;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.nio.charset.StandardCharsets;
+import java.util.UUID;
+
+/**
+ * Activity-scoped client for the station handheld remote contract.
+ *
+ * Receives {@code station/<id>/ui/control} messages containing {@code ts}, {@code src}, and
+ * {@code action}. Supported actions are {@code set_ui}, {@code reset}, and {@code feedback}.
+ * A {@code set_ui} message may include {@code yes}, {@code no}, {@code yesEnabled}, and
+ * {@code noEnabled}; any action may include a {@code feedback} object with {@code vibrateMs},
+ * {@code sound: "beep"}, and {@code animation: "pulse"}. Button presses publish an event named
+ * {@code yes} or {@code no} on {@code station/<id>/ui/event}, always with {@code ts} and {@code src}.
+ */
+final class StationMqttClient implements MqttCallbackExtended {
+    interface Listener {
+        void onControlMessage(JSONObject message);
+    }
+
+    private static final String LOG_TAG = "StationMqttClient";
+    private static final String BROKER_URI = "tcp://192.168.88.198:1883";
+    private static final String SOURCE = "android-remote";
+
+    private final Listener listener;
+    private final String controlTopic;
+    private final String eventTopic;
+    private MqttAsyncClient client;
+
+    StationMqttClient(String stationId, Listener listener) {
+        this.listener = listener;
+        controlTopic = "station/" + stationId + "/ui/control";
+        eventTopic = "station/" + stationId + "/ui/event";
+    }
+
+    synchronized void connect() {
+        if (client != null) {
+            return;
+        }
+
+        try {
+            MqttClientPersistence persistence = new MemoryPersistence();
+            client = new MqttAsyncClient(BROKER_URI, SOURCE + "-" + UUID.randomUUID(), persistence);
+            client.setCallback(this);
+
+            MqttConnectOptions options = new MqttConnectOptions();
+            options.setAutomaticReconnect(true);
+            options.setCleanSession(true);
+            client.connect(options, null, new IMqttActionListener() {
+                @Override
+                public void onSuccess(IMqttToken asyncActionToken) {
+                    // connectComplete subscribes, including after automatic reconnects.
+                }
+
+                @Override
+                public void onFailure(IMqttToken asyncActionToken, Throwable exception) {
+                    Log.w(LOG_TAG, "Unable to connect to station MQTT broker", exception);
+                }
+            });
+        } catch (MqttException exception) {
+            Log.w(LOG_TAG, "Unable to create station MQTT client", exception);
+            client = null;
+        }
+    }
+
+    synchronized void disconnect() {
+        if (client == null) {
+            return;
+        }
+
+        try {
+            client.disconnectForcibly();
+            client.close();
+        } catch (MqttException exception) {
+            Log.w(LOG_TAG, "Unable to disconnect station MQTT client", exception);
+        } finally {
+            client = null;
+        }
+    }
+
+    synchronized void publishEvent(String event) {
+        publishEvent(event, null);
+    }
+
+    /** Publishes a state transition with optional, non-image metadata. */
+    synchronized void publishEvent(String event, JSONObject metadata) {
+        if (client == null || !client.isConnected()) {
+            return;
+        }
+
+        JSONObject payload = new JSONObject();
+        try {
+            payload.put("ts", System.currentTimeMillis());
+            payload.put("src", SOURCE);
+            payload.put("event", event);
+            if (metadata != null) {
+                java.util.Iterator<String> keys = metadata.keys();
+                while (keys.hasNext()) {
+                    String key = keys.next();
+                    payload.put(key, metadata.get(key));
+                }
+            }
+            MqttMessage message = new MqttMessage(payload.toString().getBytes(StandardCharsets.UTF_8));
+            message.setQos(1);
+            client.publish(eventTopic, message);
+        } catch (JSONException | MqttException exception) {
+            Log.w(LOG_TAG, "Unable to publish station event", exception);
+        }
+    }
+
+    @Override
+    public void connectComplete(boolean reconnect, String serverURI) {
+        subscribeToControlTopic();
+    }
+
+    @Override
+    public void connectionLost(Throwable cause) {
+        Log.w(LOG_TAG, "Station MQTT connection lost", cause);
+    }
+
+    @Override
+    public void messageArrived(String topic, MqttMessage message) {
+        try {
+            JSONObject payload = new JSONObject(new String(message.getPayload(), StandardCharsets.UTF_8));
+            if (!payload.has("ts") || !payload.has("src") || !payload.has("action")) {
+                Log.w(LOG_TAG, "Ignoring station control message missing ts, src, or action");
+                return;
+            }
+            listener.onControlMessage(payload);
+        } catch (JSONException exception) {
+            Log.w(LOG_TAG, "Ignoring malformed station control message", exception);
+        }
+    }
+
+    @Override
+    public void deliveryComplete(IMqttDeliveryToken token) {
+        // No action required for QoS 1 station events.
+    }
+
+    private synchronized void subscribeToControlTopic() {
+        if (client == null || !client.isConnected()) {
+            return;
+        }
+
+        try {
+            client.subscribe(controlTopic, 1);
+        } catch (MqttException exception) {
+            Log.w(LOG_TAG, "Unable to subscribe to station controls", exception);
+        }
+    }
+}
