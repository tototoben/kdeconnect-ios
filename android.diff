+import android.view.View;
+
+/** A transparent, non-interactive overlay for the derived visitor position. */
+public final class VisitorDotView extends View {
+    private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private float x;
+    private float y;
+    private float radius;
+
+    public VisitorDotView(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        paint.setColor(0xff66d9ff);
+        setAlpha(0f);
+    }
+
+    public void showPosition(float normalizedX, float normalizedY, VisitorTracker.Distance distance) {
+        animate().cancel();
+        x = Math.max(0f, Math.min(1f, normalizedX)) * getWidth();
+        y = Math.max(0f, Math.min(1f, normalizedY)) * getHeight();
+        switch (distance) {
+            case NEAR:
+                radius = dp(18);
+                paint.setAlpha(235);
+                break;
+            case MID:
+                radius = dp(13);
+                paint.setAlpha(185);
+                break;
+            default:
+                radius = dp(9);
+                paint.setAlpha(135);
+                break;
+        }
+        if (getAlpha() == 0f) animate().alpha(1f).setDuration(180).start();
+        invalidate();
+    }
+
+    public void hideDot() {
+        animate().alpha(0f).setDuration(260).start();
+    }
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        super.onDraw(canvas);
+        if (radius > 0f) canvas.drawCircle(x, y, radius, paint);
+    }
+
+    @Override
+    public boolean onTouchEvent(MotionEvent event) {
+        return false;
+    }
+
+    private float dp(float value) {
+        return value * getResources().getDisplayMetrics().density;
+    }
+}
diff --git a/src/main/java/org/kde/kdeconnect/plugins/mousepad/VisitorTracker.java b/src/main/java/org/kde/kdeconnect/plugins/mousepad/VisitorTracker.java
new file mode 100644
index 00000000..71c3ffc0
--- /dev/null
+++ b/src/main/java/org/kde/kdeconnect/plugins/mousepad/VisitorTracker.java
@@ -0,0 +1,225 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+package org.kde.kdeconnect.plugins.mousepad;
+
+import android.content.Context;
+import android.os.SystemClock;
+import android.util.Log;
+
+import androidx.annotation.MainThread;
+import androidx.camera.core.CameraSelector;
+import androidx.camera.core.ImageAnalysis;
+import androidx.camera.core.ImageProxy;
+import androidx.camera.lifecycle.ProcessCameraProvider;
+import androidx.core.content.ContextCompat;
+
+import com.google.common.util.concurrent.ListenableFuture;
+import com.google.mlkit.vision.common.InputImage;
+import com.google.mlkit.vision.face.Face;
+import com.google.mlkit.vision.face.FaceDetection;
+import com.google.mlkit.vision.face.FaceDetector;
+import com.google.mlkit.vision.face.FaceDetectorOptions;
+
+import java.util.List;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+/**
+ * Foreground-only camera analysis. It exposes face-derived state only: no preview or image data
+ * is retained, persisted, or sent outside the process.
+ */
+final class VisitorTracker {
+    enum Distance { NEAR, MID, FAR }
+
+    interface Listener {
+        void onEntered(boolean fromLeft, Distance distance);
+        void onDistanceChanged(Distance distance);
+        void onApproached();
+        void onLeft();
+        void onPosition(float x, float y, Distance distance);
+    }
+
+    private static final String TAG = "VisitorTracker";
+    private static final long ENTER_STABLE_MS = 500;
+    private static final long LEAVE_STABLE_MS = 1000;
+    private static final long DISTANCE_STABLE_MS = 300;
+    private static final float EMA_ALPHA = .32f;
+    private static final long MIN_FRAME_INTERVAL_MS = 100; // at most 10 ML inferences/sec
+
+    private final Context context;
+    private final androidx.lifecycle.LifecycleOwner lifecycleOwner;
+    private final Listener listener;
+    private final ExecutorService analysisExecutor = Executors.newSingleThreadExecutor();
+    private final FaceDetector detector;
+    private final AtomicBoolean frameInFlight = new AtomicBoolean(false);
+    private ProcessCameraProvider cameraProvider;
+    private boolean started;
+    private boolean present;
+    private boolean approached;
+    private long firstSeenAt;
+    private long lastSeenAt;
+    private long distanceCandidateAt;
+    private Distance distance;
+    private Distance candidateDistance;
+    private float smoothedX;
+    private float smoothedY;
+    private boolean hasSmoothedPosition;
+    private volatile long lastSubmittedAt;
+
+    VisitorTracker(Context context, androidx.lifecycle.LifecycleOwner lifecycleOwner, Listener listener) {
+        this.context = context.getApplicationContext();
+        this.lifecycleOwner = lifecycleOwner;
+        this.listener = listener;
+        FaceDetectorOptions options = new FaceDetectorOptions.Builder()
+                .setPerformanceMode(FaceDetectorOptions.PERFORMANCE_MODE_FAST)
+                .setLandmarkMode(FaceDetectorOptions.LANDMARK_MODE_NONE)
+                .setClassificationMode(FaceDetectorOptions.CLASSIFICATION_MODE_NONE)
+                .setMinFaceSize(0.15f)
+                .build();
+        detector = FaceDetection.getClient(options);
+    }
+
+    @MainThread
+    void start() {
+        if (started) return;
+        started = true;
+        ListenableFuture<ProcessCameraProvider> future = ProcessCameraProvider.getInstance(context);
+        future.addListener(() -> {
+            if (!started) return;
+            try {
+                cameraProvider = future.get();
+                ImageAnalysis analysis = new ImageAnalysis.Builder()
+                        .setTargetResolution(new android.util.Size(320, 240))
+                        .setImageQueueDepth(1)
+                        .setBackpressureStrategy(ImageAnalysis.STRATEGY_KEEP_ONLY_LATEST)
+                        .build();
+                analysis.setAnalyzer(analysisExecutor, this::analyze);
+                cameraProvider.unbindAll();
+                cameraProvider.bindToLifecycle(lifecycleOwner,
+                        new CameraSelector.Builder().requireLensFacing(CameraSelector.LENS_FACING_FRONT).build(),
+                        analysis);
+            } catch (Exception exception) {
+                Log.w(TAG, "Unable to start front camera visitor tracking", exception);
+            }
+        }, ContextCompat.getMainExecutor(context));
+    }
+
+    @MainThread
+    void stop() {
+        started = false;
+        if (cameraProvider != null) {
+            cameraProvider.unbindAll();
+            cameraProvider = null;
+        }
+    }
+
+    void close() {
+        stop();
+        detector.close();
+        analysisExecutor.shutdown();
+    }
+
+    private void analyze(ImageProxy imageProxy) {
+        long now = SystemClock.elapsedRealtime();
+        if (!started || imageProxy.getImage() == null
+                || now - lastSubmittedAt < MIN_FRAME_INTERVAL_MS
+                || !frameInFlight.compareAndSet(false, true)) {
+            imageProxy.close();
+            return;
+        }
+        lastSubmittedAt = now;
+        InputImage image = InputImage.fromMediaImage(imageProxy.getImage(), imageProxy.getImageInfo().getRotationDegrees());
+        detector.process(image)
+                .addOnSuccessListener(faces -> handleFaces(faces, imageProxy.getWidth(), imageProxy.getHeight()))
+                .addOnFailureListener(error -> Log.w(TAG, "Face detection failed", error))
+                .addOnCompleteListener(ignored -> {
+                    frameInFlight.set(false);
+                    imageProxy.close();
+                });
+    }
+
+    private synchronized void handleFaces(List<Face> faces, int imageWidth, int imageHeight) {
+        if (!started) return;
+        long now = SystemClock.elapsedRealtime();
+        Face primary = null;
+        int largestArea = 0;
+        for (Face face : faces) {
+            int area = face.getBoundingBox().width() * face.getBoundingBox().height();
+            if (area > largestArea) {
+                primary = face;
+                largestArea = area;
+            }
+        }
+        if (primary == null) {
+            if (present && now - lastSeenAt >= LEAVE_STABLE_MS) {
+                present = false;
+                approached = false;
+                hasSmoothedPosition = false;
+                listener.onLeft();
+            }
+            if (!present) firstSeenAt = 0;
+            return;
+        }
+
+        // ML Kit returns the face in the InputImage coordinate system. Front-camera coordinates
+        // are mirrored so dot/entry side match what the visitor sees on the remote.
+        float rawX = 1f - (primary.getBoundingBox().centerX() / (float) imageWidth);
+        float rawY = primary.getBoundingBox().centerY() / (float) imageHeight;
+        rawX = clamp(rawX);
+        rawY = clamp(rawY);
+        if (!hasSmoothedPosition) {
+            smoothedX = rawX;
+            smoothedY = rawY;
+            hasSmoothedPosition = true;
+        } else {
+            smoothedX += EMA_ALPHA * (rawX - smoothedX);
+            smoothedY += EMA_ALPHA * (rawY - smoothedY);
+        }
+        Distance observedDistance = distanceFor(primary, imageWidth, imageHeight);
+        lastSeenAt = now;
+        if (!present) {
+            if (firstSeenAt == 0) firstSeenAt = now;
+            if (now - firstSeenAt < ENTER_STABLE_MS) return;
+            present = true;
+            distance = observedDistance;
+            candidateDistance = observedDistance;
+            approached = distance == Distance.NEAR;
+            listener.onEntered(smoothedX < .5f, distance);
+            listener.onPosition(smoothedX, smoothedY, distance);
+            if (approached) listener.onApproached();
+            return;
+        }
+
+        listener.onPosition(smoothedX, smoothedY, distance);
+        if (observedDistance == distance) {
+            candidateDistance = distance;
+            return;
+        }
+        if (observedDistance != candidateDistance) {
+            candidateDistance = observedDistance;
+            distanceCandidateAt = now;
+        } else if (now - distanceCandidateAt >= DISTANCE_STABLE_MS) {
+            distance = observedDistance;
+            listener.onDistanceChanged(distance);
+            if (distance == Distance.NEAR && !approached) {
+                approached = true;
+                listener.onApproached();
+            }
+        }
+    }
+
+    // Bounding-box height is a deliberately coarse proxy: larger faces are nearer, not measured.
+    private Distance distanceFor(Face face, int imageWidth, int imageHeight) {
+        float faceFraction = Math.max(face.getBoundingBox().width() / (float) imageWidth,
+                face.getBoundingBox().height() / (float) imageHeight);
+        if (faceFraction >= .45f) return Distance.NEAR; // approximately <= 0.75 m
+        if (faceFraction >= .22f) return Distance.MID;   // approximately 0.75-1.5 m
+        return Distance.FAR;                             // approximately > 1.5 m
+    }
+
+    private static float clamp(float value) {
+        return Math.max(0f, Math.min(1f, value));
+    }
+}
